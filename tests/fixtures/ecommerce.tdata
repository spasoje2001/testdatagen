schema Ecommerce {
    
    description: "Example for issue #21 - e-commerce"
    seed: 12345
    strategy: smart
    combination_strategy: pairwise
    
    entity User {
        fields {
            id: uuid
            
            email: email {
                unique,
                include[null, empty, invalid]
            }
            
            age: number {
                range 18..120,
                boundary,
                partitions[3]
            }
            
            status: enum ["active", "inactive", "banned"] {
                coverage 100
            }
            
            balance: number {
                range 0..10000,
                boundary
            }
            
            name: fullName {
                strategy random
            }
            
            created_at: date {
                range "2020-01-01".."2025-12-31",
                boundary
            }
        }
        
        config {
            generate: 50
            include: [
                { age: 42, email: "regression-bug-123@test.com", status: "banned", balance: 0 },
                { age: 18, email: null, status: "active", balance: 9999.99 }
            ]
        }
    }
    
    entity Product {
        fields {
            id: uuid
            name: productName
            
            price: number {
                range 0..1000,
                boundary,
                precision 2
            }
            
            stock: number {
                range 0..1000,
                boundary,
                special ["0", "1", "999", "1000"]
            }
            
            is_available: boolean {
                coverage 100
            }
        }
        
        config {
            generate: 100
            combination_strategy: full
        }
    }
    
    entity Order {
        fields {
            id: uuid
            user: ref User
            
            items: ref Product[] count 1..10 boundary
            
            total: number {
                range 0..1000,
                boundary,
                precision 2
            }
            
            status: enum ["pending", "processing", "shipped", "delivered", "cancelled"] {
                coverage 100
            }
        }
        
        config {
            generate: 200
        }
    }
}
