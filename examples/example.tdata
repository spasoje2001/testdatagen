schema Ecommerce {

    entity User {
        fields {
            id: uuid
            name: fullName
        }
    }

    entity Order {
        fields {
            id: uuid
            total: number
        }
    }

    relationship Placed {

        from User
        to Order

        properties {
            createdAt: datetime
            rating: number
        }

        config {
            strategy: one-to-one
            generate: 10

            include: [
                {
                    createdAt: "2020-01-01",
                    rating: 2
                },
                {
                    createdAt: "2020-05-05",
                    rating: 3
                }
            ]
        }
    }
}