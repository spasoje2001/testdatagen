schema Ecommerce {

    entity User {
        fields {
            id: uuid
            name: fullName
        }
        config {
            generate: 100
        }
    }

    entity Order {
        fields {
            id: uuid
            total: number
        }
        config {
            generate: 100
        }
    }

    relationship Placed {

        from User
        to Order

        properties {
            createdAt: datetime
            rating: number
        }

        config {
            strategy: many-to-many
            generate: 1000

            include: [
                {
                    createdAt: "2020-01-01",
                    rating: 2
                },
                {
                    createdAt: "2020-05-05",
                    rating: 3
                }
            ]
        }
    }
}